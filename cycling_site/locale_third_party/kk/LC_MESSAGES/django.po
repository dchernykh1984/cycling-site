msgstr "Дұрыс электрондық пошта мекенжайын енгізіңіз."

#: django/core/validators.py
msgid "Ensure this value is a multiple of step size %(limit_value)s."
msgstr "Мән %(limit_value)s санына еселі болуы керек."

#: django/core/validators.py
msgid ""
"Ensure this value is a multiple of step size %(limit_value)s, starting from "
"%(offset)s, e.g. %(offset)s, %(valid_value1)s, %(valid_value2)s, and so on."
msgstr ""
"Мән %(offset)s санынан бастап %(limit_value)s қадаммен алынуы керек, мысалы: "
"%(offset)s, %(valid_value1)s, %(valid_value2)s және т.б."

#: django/core/validators.py
msgid ""
"Ensure this value has at least %(limit_value)d character (it has "
"%(show_value)d)."
