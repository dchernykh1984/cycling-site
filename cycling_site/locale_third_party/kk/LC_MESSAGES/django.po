#: django/core/validators.py
msgid ""
"File extension “%(extension)s” is not allowed. Allowed extensions are: "
"%(allowed_extensions)s."
msgstr ""
"«%(extension)s» кеңейтімі бар файлдарға рұқсат жоқ. Рұқсат етілген "
"кеңейтімдер: %(allowed_extensions)s."

#: django/core/validators.py
msgid "Null characters are not allowed."
msgstr "Мәтінде нөлдік таңбаға (null) рұқсат жоқ."

#: django/db/models/base.py
msgid "%(model_name)s with this %(field_labels)s already exists."
msgstr ""
"%(field_labels)s өрістерінің осындай мәндері бар %(model_name)s бұрыннан бар."

#: django/db/models/constraints.py
msgid "Constraint “%(name)s” is violated."
msgstr "«%(name)s» шектеуі бұзылды."

#: django/db/models/fields/__init__.py
