msgstr ""
"Кіру кодыңыз төменде берілген. Оны браузердің ашық терезесіне енгізіңіз."

#: allauth/templates/account/email/login_code_message.txt
#: allauth/templates/account/email/password_reset_code_message.txt
#: allauth/templates/account/email/unknown_account_message.txt
msgid "This mail can be safely ignored if you did not initiate this action."
msgstr "Егер бұл әрекетті сіз бастамасаңыз, бұл хатты елемеуге болады."

#: allauth/templates/account/email/login_code_subject.txt
msgid "Sign-In Code"
msgstr "Кіру коды"

#: allauth/templates/account/email/password_changed_message.txt
msgid "Your password has been changed."
msgstr "Құпиясөзіңіз өзгертілді."

#: allauth/templates/account/email/password_changed_subject.txt
msgid "Password Changed"
msgstr "Құпиясөз өзгертілді"

#: allauth/templates/account/email/password_reset_code_message.txt
msgid ""
"Your password reset code is listed below. Please enter it in your open "
