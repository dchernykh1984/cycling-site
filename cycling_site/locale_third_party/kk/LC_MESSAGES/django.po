# Kazakh for the strings of django-allauth and Django that a reader meets and that those packages
# ship no Kazakh for; without it they fall back to Russian, the site's default language. Kept by
# hand: makemessages never writes here (see the translations skill).
msgid ""
msgstr ""
"Language: kk\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

