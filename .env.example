# Cycling site environment variables.
# Copy this file to .env and customize for your local environment.
# All variables are optional for local development with sensible defaults.
# .env is gitignored.

# ===== Database =====

# PostgreSQL connection string.
# Default: postgres://localhost/cycling_site_dev (current OS user, no password)
# DATABASE_URL=postgres://user:password@localhost:5432/cycling_site_dev

# ===== Django =====

# Secret key. The default in dev.py is a Django-insecure marker, fine for
# local development. In production this MUST be set and kept secret.
# SECRET_KEY=replace-me-with-a-long-random-string

# Comma-separated list of allowed hostnames. Only required in production.
# In dev.py this defaults to ["*"].
# ALLOWED_HOSTS=cycling.example.com,www.cycling.example.com
