# Cycling site environment variables.
# Copy this file to .env and customize for your local environment.
# All variables are optional for local development with sensible defaults.
# .env is gitignored.

# ===== Database =====

# PostgreSQL connection string.
# Default: postgres://localhost/cycling_site_dev (current OS user, no password)
# DATABASE_URL=postgres://user:password@localhost:5432/cycling_site_dev

# For local development that is all you need: dev.py hardcodes an insecure
# SECRET_KEY and ALLOWED_HOSTS = ["*"], so no further variables are required.
#
# Production configuration (SECRET_KEY, DATABASE_URL, PRIMARY_HOST, the SMTP account and the
# rest) is set in the host's dashboard - see the Deployment section in README.md.

# ===== Application =====

# Base URL used in timing-system token display and participant API.
# Default: http://localhost:8000
# SITE_BASE_URL=https://your-site.com

# IndexNow key: any random 8-128 character hex-ish string. The site serves it at
# /<key>.txt, which is how Bing, Yandex and Seznam verify we own the host, and submits
# every published page to them. Leave it unset to disable the submissions entirely.
# INDEXNOW_KEY=0123456789abcdef0123456789abcdef

# ===== Search engines =====

# Site ownership for Google Search Console and Yandex Webmaster, "HTML tag" method: paste only the
# value of content="..." from the tag each console offers. The tag then appears in every page head.
# GOOGLE_SITE_VERIFICATION=abc123...
# YANDEX_VERIFICATION=0123456789abcdef

# What the home page tells search engines about the club (schema.org SportsOrganization).
# ORGANIZATION_NAME defaults to the Wagtail site name; ORGANIZATION_SAME_AS is comma separated.
# ORGANIZATION_NAME=Universal Bicycle Team
# ORGANIZATION_AREA=Almaty
# ORGANIZATION_SAME_AS=https://t.me/your-club,https://www.strava.com/clubs/your-club
