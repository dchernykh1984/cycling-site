{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/post_edit.py\"",
            "commandWindows": "py -3 \"$(git rev-parse --show-toplevel)/.codex/hooks/post_edit.py\"",
            "timeout": 10,
            "statusMessage": "Formatting edited Python and checking for non-ASCII bytes"
          }
        ]
      }
    ]
  }
}
